# Base URL of Voone-backend_service, up to and including /api.
#
# The paths in src/lib/api-client.ts already carry their own /v1 prefix, and the backend
# mounts its v1 router at /api/v1 — so this stops at /api and the two halves meet.
NEXT_PUBLIC_VOONE_API_URL="http://localhost:4000/api"

# Public origin of THIS app, used to build the sign-up URL a clinic's QR code encodes.
# Unset, the dashboard falls back to the browser's own origin, which is right in
# development but wrong on a preview deployment — a poster printed there would point at
# the preview rather than production.
# NEXT_PUBLIC_APP_URL="https://app.voone.ai"

# --- Staff surface ---
# Server-side base URL for the backend. Falls back to NEXT_PUBLIC_VOONE_API_URL, so local
# development needs only that one. Set this when the API is reachable over a private
# network the browser cannot use.
# VOONE_API_URL="http://voone-backend.railway.internal:4000/api"

# Shared secret the backend requires on template writes, and what lets a staff sign-up
# skip the public rate limit and record consentSource as "staff_entry".
#
# NEVER prefix this NEXT_PUBLIC_. It is a bearer credential for every clinic's template, so
# it must not reach a browser: the route handlers under /api/staff hold it server-side and
# take the clinic from the session, which is what stops one clinic acting on another.
# STAFF_API_KEY=""

# Apple Wallet is gated off until a Pass Type ID certificate exists. With this unset the
# UI reports Apple as "Próximamente" rather than offering a pass it cannot issue.
# NEXT_PUBLIC_APPLE_WALLET_ENABLED="true"

# --- Local demo auth ---
# With AUTH_ENABLED unset, src/lib/auth.ts returns a mock session from cookies and
# src/proxy.ts lets every route through. Set it to "true" to require a real next-auth
# session on /dashboard and /admin.
# AUTH_ENABLED="true"
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"
# VOONE_DEV_AUTH_EMAIL=""
# VOONE_DEV_AUTH_PASSWORD=""
# VOONE_DEV_AUTH_CLINIC_SLUG="aurea"
# VOONE_DEV_AUTH_CLINIC_ID="00000000-0000-4000-8000-0000000a0001"
